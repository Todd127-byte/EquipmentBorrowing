<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:models="using:EquipmentBorrowing.Application.Models"
    x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
    x:DataType="vm:BorrowingsViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="Active Borrowings" />
                <TextBlock Classes="muted" Text="Review current checkouts and record equipment returns." />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadCommand}" />
        </Grid>

        <Border Grid.Row="1" Classes="feedback" Margin="0,18,0,12">
            <TextBlock Classes="feedback-text" Text="{Binding StatusMessage}" />
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,*,*,Auto" Margin="12,0,12,8">
                <TextBlock Classes="muted" FontWeight="SemiBold" Text="Student" />
                <TextBlock Grid.Column="1" Classes="muted" FontWeight="SemiBold" Text="Equipment" />
                <TextBlock Grid.Column="2" Classes="muted" FontWeight="SemiBold" Text="Expected return" />
                <TextBlock Grid.Column="3" Classes="muted" FontWeight="SemiBold" Text="Status" />
            </Grid>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding ActiveBorrowings}"
                         SelectedItem="{Binding SelectedBorrowing}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ActiveBorrowingSummary">
                            <Border Classes="card" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="card-text" FontWeight="SemiBold" Text="{Binding StudentName}" />
                                        <TextBlock Classes="muted" Text="{Binding StudentId, StringFormat='ID: {0}'}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Classes="card-text" FontWeight="SemiBold" Text="{Binding EquipmentName}" />
                                        <TextBlock Classes="muted" Text="{Binding EquipmentId, StringFormat='ID: {0}'}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{Binding ExpectedReturnDate, StringFormat='{}{0:MMM d, yyyy}'}" />
                                    <Border Grid.Column="3" Classes="status-chip" VerticalAlignment="Center">
                                        <TextBlock Classes="card-text" Text="{Binding Status}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock IsVisible="{Binding HasNoBorrowings}"
                           Classes="muted"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="No active borrowings to show." />
            </Grid>

            <Button Grid.Row="2" Classes="primary"
                    Content="Return Equipment"
                    Command="{Binding ReturnEquipmentCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,12,0,0" />
        </Grid>
    </Grid>
</UserControl>
